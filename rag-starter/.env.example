# Copy this file to .env and edit it. Never commit .env (it may hold your API key).
# A line left empty falls back to the default shown here.
# Keep comments on their own lines: the loader does not strip trailing comments.

# --- Only needed for live queries. Ingest, --dry-run, the tests and the eval need
# --- no API key, and no network after pip install.
ANTHROPIC_API_KEY=

# Exact model id, no date suffix. Default: claude-opus-5.
# Cheaper models such as claude-sonnet-5 or claude-haiku-4-5 are your choice:
# compare answer quality on your own questions before switching.
# The request sends no temperature/top_p/top_k, no assistant prefill and no thinking
# budget. Per Anthropic's documentation at the time of writing, Opus 5 and Sonnet 5
# class models reject those with HTTP 400; Haiku 4.5 behaves differently, so check
# the documentation for your model before adding any of them.
LLM_MODEL=claude-opus-5

# --- Retrieval settings ---
# EMBEDDER: hashing = offline demo embedder (default; English/ASCII text only);
# sentence-transformers = real semantic embeddings (pip install sentence-transformers).
# For other languages use sentence-transformers with a multilingual SENTENCE_MODEL.
EMBEDDER=hashing
# Model used when EMBEDDER=sentence-transformers (uncomment to change it):
# SENTENCE_MODEL=all-MiniLM-L6-v2

# Max words per chunk (about 300 tokens; 1 token is roughly 0.75 English words).
CHUNK_WORDS=220
# Words repeated between neighboring chunks (must be smaller than CHUNK_WORDS).
CHUNK_OVERLAP=40
# Candidates fetched from the vector store (at least 1).
TOP_K=20
# Chunks kept after re-ranking and sent to the LLM (at least 1).
RERANK_TOP_N=5
# Candidates with a lower similarity than this are dropped (must be a finite number).
MIN_SCORE=0.05
